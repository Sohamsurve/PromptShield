LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL_JUDGE=
LLM_MODEL_ARIA=
LLM_BASE_URL=
JUDGE_REASONING_EFFORT=          # e.g. low for Sol-class; omit temperature when effort != none
JUDGE_TIMEOUT_MS=30000           # reasoning models need >>1.5s; CI uses JUDGE_FORCE_OFFLINE=1
JUDGE_FORCE_OFFLINE=             # set 1 in tests/CI for offline heuristic
JUDGE_LIVE_SMOKE=                # set 1 to enable optional live smoke test
LLM_MODEL_JUDGE_CHEAP=           # optional cheaper tier for judge eval (e.g. gpt-4o-mini)
ARIA_MODE=scripted
DATABASE_URL=sqlite:///./promptshield.db
REDIS_URL=redis://localhost:6379/0
POLICY_PATH=apps/api/src/promptshield/policies/default.yml
CLASSIFIER_PATH=models/classifier.onnx
OCR_ENGINE=tesseract
API_KEY=dev-only-change-me
NEXT_PUBLIC_API_BASE=http://localhost:8000
API_HOST=0.0.0.0
API_PORT=8000
